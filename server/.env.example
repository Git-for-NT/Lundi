# =============================================================================
# server/.env.example
#
# HOW TO USE:
#   Copy this file to a new file named ".env" in the same directory:
#
#     cp server/.env.example server/.env
#
#   Then fill in any required values before starting the server.
#
# WHY .env IS GITIGNORED:
#   The ".env" file holds real secrets (your OpenAI API key). Committing it
#   would expose your key to everyone with access to the repository, which
#   could result in unexpected charges or abuse. The root .gitignore ensures
#   ".env" is never tracked. This ".env.example" file acts as a safe,
#   committed template that documents every variable without containing any
#   real secrets.
#
# WHAT HAPPENS IF OPENAI_API_KEY IS MISSING:
#   The server validates this variable at startup. If it is absent or empty,
#   the process will exit immediately with a descriptive error message. The
#   server will not start or accept connections until a valid key is provided.
# =============================================================================


# -----------------------------------------------------------------------------
# OPENAI_API_KEY (Required)
#
# Your secret API key issued by OpenAI. The server uses this to authenticate
# every request it makes to the OpenAI Chat Completions API.
#
# Where to get it:
#   1. Sign in at https://platform.openai.com/
#   2. Navigate to API Keys (https://platform.openai.com/api-keys)
#   3. Click "Create new secret key", copy the value, and paste it below.
#
# Security warning:
#   This key is tied to your OpenAI account and billing. NEVER commit it to
#   version control, share it in chat, or embed it in client-side code. Treat
#   it like a password. If you accidentally expose it, revoke it immediately
#   from the OpenAI dashboard and generate a new one.
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-...


# -----------------------------------------------------------------------------
# OPENAI_MODEL (Optional)
#
# The OpenAI language model used to generate chat completions. Changing this
# value lets you trade off response quality, speed, and cost without modifying
# any source code.
#
# If this variable is absent, the server defaults to: gpt-3.5-turbo
#
# Other valid values:
#   gpt-3.5-turbo   — Fast and inexpensive; good for most use cases (default)
#   gpt-4           — More capable reasoning; slower and more expensive
#   gpt-4o          — Optimised GPT-4 variant; faster than gpt-4, multimodal
#   gpt-4o-mini     — Lightweight GPT-4o; low cost, strong performance
#
# Check https://platform.openai.com/docs/models for the full list of
# available models and their capabilities.
# -----------------------------------------------------------------------------
OPENAI_MODEL=gpt-3.5-turbo


# -----------------------------------------------------------------------------
# PORT (Optional)
#
# The TCP port the Express server listens on. If absent, the server defaults
# to port 3001.
#
# Important: If you change this value, you MUST also update the proxy target
# in client/vite.config.ts to match. The Vite dev server proxies all /api
# requests to this port, so a mismatch will cause every API call from the
# client to fail with a connection error.
#
# Example: if you set PORT=4000 here, update vite.config.ts to:
#   target: 'http://localhost:4000'
# -----------------------------------------------------------------------------
PORT=3001
